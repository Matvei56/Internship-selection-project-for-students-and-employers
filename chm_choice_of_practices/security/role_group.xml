<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="module_category_chm_choice_of_practices">
            <field name="name">Вибір практики</field>
            <field name="sequence">100</field>
            <field name="parent_id" eval="False"/>
        </record>
        <record id="group_student" model="res.groups">
            <field name="name">Студент</field>
            <field name="category_id" ref="chm_choice_of_practices.module_category_chm_choice_of_practices"/>
        </record>
        <record id="group_student_only" model="res.groups">
            <field name="name">Студент (обмежений доступ)</field>
            <field name="category_id" ref="chm_choice_of_practices.module_category_chm_choice_of_practices"/>
        </record>

        <record id="group_practice_manager" model="res.groups">
            <field name="name">Керівник практики</field>
            <field name="category_id" ref="chm_choice_of_practices.module_category_chm_choice_of_practices"/>
            <field name="implied_ids" eval="[(4, ref('group_student'))]"/>
        </record>
        <record id="group_administrator" model="res.groups">
            <field name="name">Адміністратор</field>
            <field name="category_id" ref="chm_choice_of_practices.module_category_chm_choice_of_practices"/>
            <field name="implied_ids" eval="[(4, ref('group_practice_manager'))]"/>
        </record>
        <record id="base.user_admin" model="res.users">
            <field name="groups_id" eval="[(4,ref('chm_choice_of_practices.group_administrator'))]"/>
        </record>
        <record id="base.default_user" model="res.users">
            <field name="groups_id" eval="[(4,ref('chm_choice_of_practices.group_student'))]"/>
        </record>


    </data>
</odoo>