<!--        <field name="groups" eval="[(4, ref('chm_choice_of_practices.group_head_of_department'))]"/>-->
<!--    </record>-->

    <record id="enterprises_rule_student_own" model="ir.rule">
        <field name="name">Student: only active enterprises</field>
        <field name="model_id" ref="model_chm_choice_of_practices_enterprises"/>
        <field name="domain_force">[('state', '=', 'active')]</field>
        <field name="groups" eval="[(4, ref('chm_choice_of_practices.group_student_only'))]"/>
    </record>
    <record id="enterprises_rule_admin_all" model="ir.rule">
        <field name="name">Admin: all enterprises</field>
        <field name="model_id" ref="model_chm_choice_of_practices_enterprises"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('chm_choice_of_practices.group_administrator'))]"/>
    </record>

    <!-- todo тимчасово -->
    <record id="enterprises_rule_practice_manager_all" model="ir.rule">
        <field name="name">Practice manager: all enterprises</field>
        <field name="model_id" ref="model_chm_choice_of_practices_enterprises"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('chm_choice_of_practices.group_head_of_department'))]"/>
    </record>

    <record id="practice_request_rule_department_head" model="ir.rule">
        <field name="name">Department head: own department requests</field>
        <field name="model_id" ref="model_chm_choice_of_practices_practice_request"/>
        <field name="domain_force">[('department_id', '=', user.partner_id.department_id.id)]</field>
        <field name="groups" eval="[(4, ref('chm_choice_of_practices.group_head_of_department'))]"/>
    </record>

</odoo>