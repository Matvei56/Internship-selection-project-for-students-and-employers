<odoo>
    <record id="ir_cron_check_practice_agreements" model="ir.cron">
        <field name="name">Check Practice Agreements State</field>
        <field name="model_id" ref="model_chm_choice_of_practices_practice_agreement"/>
        <field name="state">code</field>
        <field name="code">model.cron_check_agreements_state()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>

    <record id="ir_cron_recompute_courses_september" model="ir.cron">
        <field name="name">Recompute student courses every September</field>
        <field name="model_id" ref="model_chm_choice_of_practices_student_group"/>
        <field name="state">code</field>
        <field name="code">model.recompute_courses_cron()</field>
        <field name="interval_number">12</field>
        <field name="interval_type">months</field>
        <field name="nextcall">2026-09-01 00:00:00</field>
        <field name="active">True</field>
    </record>
</odoo>