<odoo>
    <record id="view_institutes_form" model="ir.ui.view">
        <field name="name">institutes.form</field>
        <field name="model">chm_choice_of_practices.institutes</field>
        <field name="arch" type="xml">
            <form string="Інститут">
                <sheet>

                    <group>
                        <field name="name"/>
                    </group>

                    <notebook>

                        <page string="Кафедри">
                            <field name="departments_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>

    <record id="view_institutes_tree" model="ir.ui.view">
        <field name="name">institutes.tree</field>
        <field name="model">chm_choice_of_practices.institutes</field>
        <field name="arch" type="xml">
            <tree string="Інститути">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_institutes" model="ir.actions.act_window">
        <field name="name">Інститути</field>
        <field name="res_model">chm_choice_of_practices.institutes</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>