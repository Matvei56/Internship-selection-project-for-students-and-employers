<odoo>
    <record id="view_form_practice_request" model="ir.ui.view">
        <field name="name">chm_choice_of_practices.practice_request.form</field>
        <field name="model">chm_choice_of_practices.practice_request</field>
        <field name="arch" type="xml">
            <form string="Заяви на практику">
                <header>
                    <field name="state" widget="statusbar" options="{'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"
                         groups="chm_choice_of_practices.group_practice_manager">
                        <button class="oe_stat_button" name="action_approve" type="object">
                            <div style="display: flex; justify-content: center;">
                                <div class="o_stat_info" style="display: flex; justify-content: center;">
                                    <strong class="ml-2">
                                        Схвалити
                                    </strong>
                                </div>
                            </div>
                        </button>
                        <button class="oe_stat_button" name="action_reject" type="object">
                            <div style="display: flex; justify-content: center;">
                                <div class="o_stat_info" style="display: flex; justify-content: center;">
                                    <strong class="ml-2">
                                        Відхилити
                                    </strong>
                                </div>
                            </div>
                        </button>
                        <button class="oe_stat_button" name="action_needs_edits" type="object">
                            <div style="display: flex; justify-content: center;">
                                <div class="o_stat_info" style="display: flex; justify-content: center;">
                                    <strong class="ml-2">
                                        Потребує правок
                                    </strong>
                                </div>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title" style="display: flex; align-items: center; min-width: 80%;">
                        <h1 style="flex-grow: 1; white-space: nowrap; overflow: hidden;">
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="enterprises_id"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <group>
                        <field name="comment" placeholder="Коментар"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_tree_practice_request" model="ir.ui.view">
        <field name="name">chm_choice_of_practices.practice_request.tree</field>
        <field name="model">chm_choice_of_practices.practice_request</field>
        <field name="arch" type="xml">
            <tree string="Заяви на практику"
                  decoration-muted="state=='new'"
                  decoration-danger="state=='rejected'"
                  decoration-warning="state=='needs_edits'"
                  decoration-info="state=='in_progress'"
                  decoration-success="state=='approved'">
                <field name="name"/>
                <field name="state"/>
                <field name="student_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
            </tree>
        </field>
    </record>


    <record id="view_practice_request_search" model="ir.ui.view">
        <field name="name">chm_choice_of_practices.practice_request.search</field>
        <field name="model">chm_choice_of_practices.practice_request</field>
        <field name="arch" type="xml">
            <search string="Заяви на практику">
                <field name="name" string="Назва"/>
                <field name="student_id" string="Студент"/>
                <field name="enterprises_id" string="Підприємство"/>
                <field name="date_from" string="Дата створення"/>
                <field name="date_to" string="Дата завершення"/>
                <separator/>

                <filter name="state_new"
                        string="Нові"
                        domain="[('state','=','new')]"/>
                <filter name="state_in_progress"
                        string="В обробці"
                        domain="[('state','=','in_progress')]"/>
                <filter name="state_approved"
                        string="Схвалені"
                        domain="[('state','=','approved')]"/>
                <filter name="state_rejected"
                        string="Відхилені"
                        domain="[('state','=','rejected')]"/>
                <filter name="state_needs_edits"
                        string="Потребують правок"
                        domain="[('state','=','needs_edits')]"/>
                <separator/>

                <filter name="today"
                        string="Створені сьогодні"
                        domain="[('date_from','=',context_today().strftime('%%Y-%%m-%%d'))]"/>
                <filter name="this_month"
                        string="Створені цього місяця"
                        domain="[('date_from','>=', (context_today().replace(day=1)).strftime('%%Y-%%m-%%d'))]"/>
                <separator/>


                <group expand="0" string="Групувати за">
                    <filter name="group_by_state"
                            string="Статус"
                            context="{'group_by':'state'}"/>
                    <filter name="group_by_student"
                            string="Студент"
                            context="{'group_by':'student_id'}"/>
                    <filter name="group_by_enterprise"
                            string="Підприємство"
                            context="{'group_by':'enterprises_id'}"/>
                    <filter name="group_by_date"
                            string="Дата створення"
                            context="{'group_by':'date_from'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="action_practice_request" model="ir.actions.act_window">
        <field name="name">Заяви на практику</field>
        <field name="res_model">chm_choice_of_practices.practice_request</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>Список заяв</p>
        </field>
    </record>
</odoo>
