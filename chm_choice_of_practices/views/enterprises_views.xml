<odoo>
    <record id="view_form_enterprises" model="ir.ui.view">
        <field name="name">chm_choice_of_practices.enterprises.form</field>
        <field name="model">chm_choice_of_practices.enterprises</field>
        <field name="arch" type="xml">
            <form string="Підприємства">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="actions_create_request" type="object">
                            <div style="display: flex; justify-content: center;">
                                <div class="o_stat_info" style="display: flex; justify-content: center;">
                                    <strong class="ml-2">
                                        Подати заявку
                                    </strong>
                                </div>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title" style="display: flex; align-items: center; min-width: 80%;">
                        <h1 style="flex-grow: 1; white-space: nowrap; overflow: hidden;">
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
<!--                            <field name="partner_id"/>-->
                            <field name="edrpou"/>
                            <field name="address"/>
                            <field name="cite"/>
                            <field name="field_of_activity"/>
                            <field name="notes"/>
                        </group>
                    </group>
                    <group>
                        <field name="practice_request_ids" groups="chm_choice_of_practices.group_practice_manager">
                            <tree>
                                <field name="name"/>
                                <field name="state"/>
                                <field name="student_id"/>
                                <field name="agreement_id"/>
                                <field name="date_from"/>
                                <field name="date_to"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tree_enterprises" model="ir.ui.view">
        <field name="name">chm_choice_of_practices.enterprises.tree</field>
        <field name="model">chm_choice_of_practices.enterprises</field>
        <field name="arch" type="xml">
            <tree string="Підприємства">
                <field name="name"/>
<!--                <field name="partner_id"/>-->
                <field name="edrpou"/>
                <field name="address"/>
                <field name="cite"/>
                <field name="field_of_activity"/>
                <field name="notes"/>
            </tree>
        </field>
    </record>

    <record id="action_enterprises" model="ir.actions.act_window">
        <field name="name">Підприємства</field>
        <field name="res_model">chm_choice_of_practices.enterprises</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>Список підприємств</p>
        </field>
    </record>

</odoo>
