<odoo>
    <record id="view_departments_form" model="ir.ui.view">
        <field name="name">chm_choice_of_practices.departments.form</field>
        <field name="model">chm_choice_of_practices.departments</field>
        <field name="arch" type="xml">
            <form string="Кафедра">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="institutes_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_departments_tree" model="ir.ui.view">
        <field name="name">chm_choice_of_practices.departments.tree</field>
        <field name="model">chm_choice_of_practices.departments</field>
        <field name="arch" type="xml">
            <tree string="Кафедри">
                <field name="name"/>
            </tree>
        </field>
    </record>


    <record id="action_departments" model="ir.actions.act_window">
        <field name="name">Кафедри</field>
        <field name="res_model">chm_choice_of_practices.departments</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>