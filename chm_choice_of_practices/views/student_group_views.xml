<odoo>
    <record id="view_form_student_group" model="ir.ui.view">
        <field name="name">chm_choice_of_practices.student_group.form</field>
        <field name="model">chm_choice_of_practices.student_group</field>
        <field name="arch" type="xml">
            <form string="Групи">
                <sheet>
                    <group>
                        <group>
                            <field name="abbreviation"/>
                            <field name="number"/>
                            <field name="full_name"/>
                            <field name="course"/>
                            <field name="education_program_program_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_tree_student_group" model="ir.ui.view">
        <field name="name">chm_choice_of_practices.student_group.tree</field>
        <field name="model">chm_choice_of_practices.student_group</field>
        <field name="arch" type="xml">
            <tree string="Групи">
                <field name="abbreviation"/>
                <field name="number"/>
                <field name="full_name"/>
                <field name="education_program_program_id"/>
            </tree>
        </field>
    </record>

    <record id="action_student_group" model="ir.actions.act_window">
        <field name="name">Групи</field>
        <field name="res_model">chm_choice_of_practices.student_group</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>Список Групи</p>
        </field>
    </record>

</odoo>
