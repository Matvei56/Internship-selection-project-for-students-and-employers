<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="signup_fields_custom" inherit_id="auth_signup.fields">

        <xpath expr="//div[contains(@class,'field-name')]" position="after">
            <div class="form-group field-first_name">
                <label for="name">Прізвище Ім'я По батькові</label>
                <input type="text" name="name" t-att-value="name" id="name" class="form-control form-control-sm"
                       placeholder="Петренко Петро Петрович"
                       required="required" t-att-readonly="'readonly' if only_passwords else None"
                       t-att-autofocus="'autofocus' if login and not only_passwords else None"/>
            </div>

        </xpath>
        <xpath expr="//div[contains(@class,'field-name')]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//input[@name='login']" position="attributes">
            <attribute name="type">email</attribute>
            <attribute name="pattern">^[^@]+@stu\.cn\.ua$</attribute>
            <attribute name="title">Дозволені тільки email домену @stu.cn.ua</attribute>
            <attribute name="placeholder">example@stu.cn.ua</attribute>
        </xpath>
    </template>
</odoo>