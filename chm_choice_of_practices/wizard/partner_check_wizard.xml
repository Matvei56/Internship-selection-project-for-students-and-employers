<odoo>
    <record id="view_partner_check_wizard_form" model="ir.ui.view">
        <field name="name">partner.check.wizard.form</field>
        <field name="model">partner.check.wizard</field>
        <field name="arch" type="xml">
            <form string="Перевірка даних">

                <group>
                    <field name="partner_id" invisible="1"/>
                    <field name="enterprises_id" invisible="1"/>
                    <field name="last_name"/>
                    <field name="first_name"/>
                    <field name="middle_name"/>
                    <field name="student_group_id"/>
                </group>

                <footer>
                    <button name="action_confirm" type="object"
                            string="Підтвердити" class="btn-primary"/>
                    <button string="Скасувати" special="cancel"/>
                </footer>

            </form>
        </field>
    </record>
    <record id="action_partner_check_wizard" model="ir.actions.act_window">
        <field name="name">Перевірка даних</field>
        <field name="res_model">partner.check.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>